# Ports published on the host, always bound to 127.0.0.1.
API_PORT=8080
GATEWAY_PORT=8081
MINIO_PORT=9000

# local enables POST /v1/auth/dev-login and make seed. Any other environment uses production.
APP_ENV=local
# Signs the API access tokens (HS256, at least 32 characters). Local value only; never reuse it.
JWT_SECRET=local-only-secret-change-me-0123456789

# MinIO root credentials, also used by the API to reach the packages bucket. Local values only.
S3_ACCESS_KEY_ID=smart-harness-local
S3_SECRET_ACCESS_KEY=local-only-minio-secret-change-me

# Browser origins allowed to call the gateway MCP endpoint, comma separated. Empty refuses any request with an Origin header.
GATEWAY_ALLOWED_ORIGINS=

# Model proxy: the organization's OpenRouter key (never shown to developers) and the Anthropic-compatible base URL.
# Empty key: POST /v1/messages on the gateway answers 503.
MODEL_UPSTREAM_KEY=
MODEL_UPSTREAM_URL=https://openrouter.ai/api

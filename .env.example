# Ports published on the host, always bound to 127.0.0.1.
API_PORT=8080
GATEWAY_PORT=8081
MINIO_PORT=9000

# local enables POST /v1/auth/dev-login and make seed. Any other environment uses production.
APP_ENV=local
# Shared SQLite file inside the sqlite-data volume, used by both API and gateway.
# Unset or empty preserves /data/control-plane.sqlite.
# Existing local installs: uncomment to start the personal demo in a separate file.
# This preserves the old database and its tokens; it does not copy them to the new file.
# DATABASE_PATH=/data/personal-demo.sqlite
# Signs the API access tokens (HS256, at least 32 characters). Local value only; never reuse it.
JWT_SECRET=local-only-secret-change-me-0123456789

# MinIO root credentials, also used by the API to reach the packages bucket. Local values only.
S3_ACCESS_KEY_ID=smart-harness-local
S3_SECRET_ACCESS_KEY=local-only-minio-secret-change-me

# Browser origins allowed to call the gateway MCP endpoint, comma separated. Empty refuses any request with an Origin header.
GATEWAY_ALLOWED_ORIGINS=

# Legacy project seed inputs. The default personal seed does not use these variables.
# GitHub repositories, comma separated owner/repo.
GITHUB_REPOS=
# Trello board id (the short id of the board URL works).
TRELLO_BOARD_ID=
# Notion page ids, comma separated (32 hex characters, with or without dashes).
NOTION_PAGE_IDS=

# Personal connector grants for the local DEV user, written by make seed (APP_ENV=local).
# Empty revokes that server's personal grants on seed. After changes run make up, then make seed.
DEMO_GITHUB_REPO=nelsonfrugeri-tech/md2poui
DEMO_TRELLO_BOARD_ID=
DEMO_NOTION_PAGE_IDS=

# Service credentials, used only by the gateway and never sent to the developer. Leave empty to keep the server off.
# GitHub: fine-grained token, read-only (Contents, Issues, Pull requests), only on the repositories above.
GITHUB_TOKEN=
# Trello: API key and token from https://trello.com/power-ups/admin
TRELLO_API_KEY=
TRELLO_TOKEN=
# Notion: internal integration token (https://www.notion.so/my-integrations), shared with the pages above.
NOTION_TOKEN=

# Model proxy: the organization's OpenRouter key (never shown to developers) and the Anthropic-compatible base URL.
# Empty key: POST /v1/messages on the gateway answers 503.
MODEL_UPSTREAM_KEY=
MODEL_UPSTREAM_URL=https://openrouter.ai/api

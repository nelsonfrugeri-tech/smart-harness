{
  "name": "smart-harness-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src scripts *.json *.html *.js *.ts",
    "format:check": "prettier --check src scripts *.json *.html *.js *.ts",
    "check": "npm run contract:check && npm run format:check && npm run lint && npm run test && npm run build",
    "test": "vitest run",
    "contract:types": "node scripts/contract-types.mjs",
    "contract:check": "node scripts/contract-types.mjs --check"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.7"
  }
}

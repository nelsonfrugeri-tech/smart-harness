{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart Harness control plane",
    "version": "0.3.0",
    "description": "Local login, memberships, Marketplace, setup-plan, package download and gateway tokens. A resource the caller cannot see answers 404, the same as one that does not exist. Errors are application/problem+json (RFC 9457); clients branch on `code`. The gateway token (GatewayToken) works only on the operations that list it in `security`; every other route, unknown ones included, answers 401 `gateway_token_not_allowed` to it."
  },
  "servers": [{ "url": "http://127.0.0.1:8080", "description": "Local (make up)" }],
  "security": [{ "BearerAuth": [] }],
  "tags": [
    { "name": "ops" },
    { "name": "auth" },
    { "name": "workspace" },
    { "name": "marketplace" },
    { "name": "gateway-tokens" }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "tags": ["ops"],
        "security": [],
        "summary": "The process answers",
        "responses": {
          "200": { "description": "Alive", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Status" } } } }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadiness",
        "tags": ["ops"],
        "security": [],
        "summary": "The database and the package bucket answer",
        "responses": {
          "200": { "description": "Ready", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Status" } } } },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getMetrics",
        "tags": ["ops"],
        "security": [],
        "summary": "Prometheus metrics",
        "responses": {
          "200": { "description": "Prometheus text format", "content": { "text/plain": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/v1/auth/dev-login": {
      "post": {
        "operationId": "devLogin",
        "tags": ["auth"],
        "security": [],
        "summary": "Local-only login by e-mail (exists only with APP_ENV=local)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "additionalProperties": false,
                "properties": { "email": { "type": "string", "format": "email", "maxLength": 254 } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["access_token", "token_type", "expires_in"],
                  "properties": {
                    "access_token": { "type": "string" },
                    "token_type": { "const": "Bearer" },
                    "expires_in": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "getMe",
        "tags": ["auth"],
        "security": [{ "BearerAuth": [] }, { "GatewayToken": [] }],
        "summary": "The caller and their memberships",
        "responses": {
          "200": {
            "description": "Caller",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["user", "memberships"],
                  "properties": {
                    "user": { "$ref": "#/components/schemas/User" },
                    "memberships": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["tenant", "role"],
                        "properties": {
                          "tenant": {
                            "type": "object",
                            "required": ["id", "slug", "name"],
                            "properties": { "id": { "type": "string" }, "slug": { "type": "string" }, "name": { "type": "string" } }
                          },
                          "role": { "enum": ["ADMIN", "DEV"] }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/workspace": {
      "get": {
        "operationId": "getWorkspace",
        "tags": ["workspace"],
        "security": [{ "BearerAuth": [] }, { "GatewayToken": [] }],
        "summary": "The caller's projects (up to 100), each with its baseline",
        "responses": {
          "200": { "description": "Workspace", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } } },
          "401": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/projects/{slug}/setup-plan": {
      "get": {
        "operationId": "getSetupPlan",
        "tags": ["workspace"],
        "security": [{ "BearerAuth": [] }, { "GatewayToken": [] }],
        "summary": "What `harness setup <slug>` installs. Never contains a token or other secret.",
        "parameters": [{ "name": "slug", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 100 } }],
        "responses": {
          "200": { "description": "Setup plan", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SetupPlan" } } } },
          "401": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/marketplace": {
      "get": {
        "operationId": "listMarketplace",
        "tags": ["marketplace"],
        "security": [{ "BearerAuth": [] }, { "GatewayToken": [] }],
        "summary": "Visible plugins ordered by name, each with its latest visible version",
        "description": "Visible means: owned by a squad of the caller, or published with visibility organization. A user without memberships sees nothing. With `project`, the list is the project's optionals: what the project's squad sees, minus the project's baseline.",
        "parameters": [
          { "name": "type", "in": "query", "description": "Calculated package type", "schema": { "type": "string", "enum": ["connector", "skill", "agent"] } },
          { "name": "kind", "in": "query", "description": "Only plugins whose latest visible version ships a component of this kind", "schema": { "$ref": "#/components/schemas/ComponentKind" } },
          { "name": "project", "in": "query", "description": "Project slug; unknown or invisible answers 404", "schema": { "type": "string", "minLength": 1, "maxLength": 100 } },
          { "name": "q", "in": "query", "description": "Case-insensitive substring of the plugin name, description, keywords or a component name or description", "schema": { "type": "string", "minLength": 1, "maxLength": 100 } },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": { "description": "Page of plugins", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PluginPage" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/plugins/{name}": {
      "get": {
        "operationId": "getPlugin",
        "tags": ["marketplace"],
        "security": [{ "BearerAuth": [] }, { "GatewayToken": [] }],
        "summary": "A plugin with its latest visible version",
        "parameters": [{ "$ref": "#/components/parameters/PluginName" }],
        "responses": {
          "200": { "description": "Plugin", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PluginItem" } } } },
          "401": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/plugins/{name}/versions": {
      "get": {
        "operationId": "listPluginVersions",
        "tags": ["marketplace"],
        "security": [{ "BearerAuth": [] }, { "GatewayToken": [] }],
        "summary": "Visible versions of a plugin, newest first",
        "parameters": [
          { "$ref": "#/components/parameters/PluginName" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": { "description": "Page of versions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VersionPage" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/plugins/{name}/versions/{version}/archive": {
      "get": {
        "operationId": "downloadPluginArchive",
        "tags": ["marketplace"],
        "security": [{ "BearerAuth": [] }, { "GatewayToken": [] }],
        "summary": "The package tar.gz, read from object storage by digest",
        "description": "The sha256 of the body equals the `x-package-digest` header.",
        "parameters": [
          { "$ref": "#/components/parameters/PluginName" },
          { "name": "version", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" } }
        ],
        "responses": {
          "200": {
            "description": "Package archive",
            "headers": {
              "x-package-digest": { "description": "sha256 of the body", "schema": { "$ref": "#/components/schemas/Digest" } },
              "content-disposition": { "schema": { "type": "string" } }
            },
            "content": { "application/gzip": { "schema": { "type": "string", "contentMediaType": "application/gzip" } } }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/me/gateway-tokens": {
      "post": {
        "operationId": "createGatewayToken",
        "tags": ["gateway-tokens"],
        "security": [{ "BearerAuth": [] }],
        "summary": "Creates a gateway token for the caller; the value appears only in this response",
        "description": "JWT only: a gateway token answers 401. The token expires after GATEWAY_TOKEN_TTL_DAYS (default 90). Records the audit event gateway_token.created, without the value or its hash.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Token created. Sent with Cache-Control: no-store.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GatewayTokenCreated" } } }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" }
        }
      },
      "get": {
        "operationId": "listGatewayTokens",
        "tags": ["gateway-tokens"],
        "security": [{ "BearerAuth": [] }],
        "summary": "The caller's gateway tokens, newest first, revoked and expired ones included, never with value or hash",
        "description": "JWT only: a gateway token answers 401.",
        "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }],
        "responses": {
          "200": { "description": "Page of tokens", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GatewayTokenPage" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/v1/me/gateway-tokens/{id}": {
      "delete": {
        "operationId": "revokeGatewayToken",
        "tags": ["gateway-tokens"],
        "security": [{ "BearerAuth": [] }],
        "summary": "Revokes one of the caller's gateway tokens",
        "description": "JWT only: a gateway token answers 401. Revoking an already revoked token answers 204 again. A token of another user answers 404, like a missing one. Records the audit event gateway_token.revoked once.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 100 } }],
        "responses": {
          "204": { "description": "Revoked" },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "GatewayToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "shg_ followed by 43 base64url characters",
        "description": "The developer's opaque token from POST /v1/me/gateway-tokens. Valid while it is not revoked and not expired."
      }
    },
    "parameters": {
      "PluginName": { "name": "name", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } },
      "Cursor": { "name": "cursor", "in": "query", "description": "next_cursor of the previous page; an invalid cursor answers 400 invalid_cursor", "schema": { "type": "string", "minLength": 1, "maxLength": 256 } },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }
    },
    "responses": {
      "Problem": {
        "description": "Error (RFC 9457)",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    },
    "schemas": {
      "Status": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "type": "string" } }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "code", "correlation_id"],
        "properties": {
          "type": { "const": "about:blank" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "code": { "type": "string", "examples": ["not_found", "invalid_cursor", "validation_failed", "missing_token"] },
          "detail": { "type": "string" },
          "correlation_id": { "type": "string" },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "message"],
              "properties": { "path": { "type": "string" }, "message": { "type": "string" } }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "email", "name"],
        "properties": { "id": { "type": "string" }, "email": { "type": "string" }, "name": { "type": "string" } }
      },
      "TenantRef": {
        "type": "object",
        "required": ["slug", "name"],
        "additionalProperties": false,
        "properties": { "slug": { "type": "string" }, "name": { "type": "string" } }
      },
      "Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
      "Visibility": { "enum": ["squad", "organization"] },
      "ComponentKind": { "enum": ["agent", "skill", "mcp"] },
      "Component": {
        "type": "object",
        "required": ["kind", "name", "description"],
        "additionalProperties": false,
        "properties": {
          "kind": { "$ref": "#/components/schemas/ComponentKind" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "PluginVersion": {
        "type": "object",
        "required": ["version", "visibility", "description", "digest", "size_bytes", "published_at", "archive_url"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string" },
          "visibility": { "$ref": "#/components/schemas/Visibility" },
          "description": { "type": "string" },
          "digest": { "$ref": "#/components/schemas/Digest" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "published_at": { "type": "string", "format": "date-time" },
          "archive_url": { "type": "string", "description": "Path of the archive download, relative to the API base" }
        }
      },
      "PluginItem": {
        "type": "object",
        "description": "A plugin with one version (the latest visible one, or the pinned one in a baseline) and that version's components",
        "required": ["plugin", "version", "components", "type", "keywords"],
        "additionalProperties": false,
        "properties": {
          "plugin": {
            "type": "object",
            "required": ["name", "description", "tenant"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "tenant": { "$ref": "#/components/schemas/TenantRef" }
            }
          },
          "version": { "$ref": "#/components/schemas/PluginVersion" },
          "type": { "type": "string", "enum": ["connector", "skill", "agent"], "description": "Only MCP components: connector; only skills: skill; otherwise: agent" },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "components": { "type": "array", "items": { "$ref": "#/components/schemas/Component" } }
        }
      },
      "PluginPage": {
        "type": "object",
        "required": ["items", "next_cursor"],
        "additionalProperties": false,
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/PluginItem" } },
          "next_cursor": { "type": ["string", "null"] }
        }
      },
      "VersionPage": {
        "type": "object",
        "required": ["items", "next_cursor"],
        "additionalProperties": false,
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/PluginVersion" } },
          "next_cursor": { "type": ["string", "null"] }
        }
      },
      "Workspace": {
        "type": "object",
        "required": ["user", "projects"],
        "additionalProperties": false,
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "projects": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": ["slug", "name", "description", "tenant", "counts", "baseline"],
              "additionalProperties": false,
              "properties": {
                "slug": { "type": "string" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "tenant": { "$ref": "#/components/schemas/TenantRef" },
                "counts": {
                  "type": "object",
                  "description": "Components in the project's baseline, by kind",
                  "required": ["agent", "skill", "mcp"],
                  "additionalProperties": false,
                  "properties": { "agent": { "type": "integer" }, "skill": { "type": "integer" }, "mcp": { "type": "integer" } }
                },
                "baseline": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["plugin", "version"],
                    "additionalProperties": false,
                    "properties": { "plugin": { "type": "string" }, "version": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      },
      "SetupPlan": {
        "type": "object",
        "required": ["project", "gateway", "baseline", "optional"],
        "additionalProperties": false,
        "properties": {
          "project": {
            "type": "object",
            "required": ["slug", "name", "description", "tenant"],
            "additionalProperties": false,
            "properties": {
              "slug": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "tenant": { "$ref": "#/components/schemas/TenantRef" }
            }
          },
          "gateway": {
            "type": "object",
            "description": "Where the coding agent sends MCP and model calls. The developer's gateway token is never part of the plan.",
            "required": ["url"],
            "additionalProperties": false,
            "properties": { "url": { "type": "string", "format": "uri" } }
          },
          "baseline": { "type": "array", "items": { "$ref": "#/components/schemas/PluginItem" } },
          "optional": {
            "description": "First page of optionals; continue with GET /v1/marketplace?project=<slug>&cursor=<next_cursor>",
            "$ref": "#/components/schemas/PluginPage"
          }
        }
      },
      "GatewayToken": {
        "type": "object",
        "description": "A gateway token without its value or hash. revoked_at is null while the token is not revoked.",
        "required": ["id", "name", "created_at", "expires_at", "revoked_at"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "revoked_at": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "GatewayTokenCreated": {
        "type": "object",
        "description": "Returned once, at creation. The API stores only the sha256 of `token` and never shows it again.",
        "required": ["id", "name", "token", "created_at", "expires_at"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "token": { "type": "string", "pattern": "^shg_[A-Za-z0-9_-]{43}$" },
          "created_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "GatewayTokenPage": {
        "type": "object",
        "required": ["items", "next_cursor"],
        "additionalProperties": false,
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/GatewayToken" } },
          "next_cursor": { "type": ["string", "null"] }
        }
      }
    }
  }
}
